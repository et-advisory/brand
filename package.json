{
  "name": "et-advisory",
  "version": "3.0.0",
  "private": true,
  "description": "ET Advisory (ETA) brand system: design tokens, logo files, live React components and brand book.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    "./tokens.json": "./tokens/tokens.json",
    "./tokens.css": "./tokens/tokens.css",
    "./logos/*": "./logos/*",
    "./components/bundle.js": "./components/bundle.js",
    "./components/bundle.css": "./components/bundle.css",
    "./components/index.d.ts": "./components/index.d.ts",
    "./preset": "./preset.js"
  },
  "files": [
    "tokens",
    "logos",
    "components",
    "docs",
    "preset.js"
  ],
  "scripts": {
    "build:tokens": "node scripts/build-tokens.mjs",
    "build:logos": "python3 scripts/logo/generate.py",
    "build": "npm run build:tokens && npm run build:logos"
  },
  "types": "./components/index.d.ts",
  "peerDependencies": {
    "tailwindcss": "^3.4"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  }
}
